# SmartCampus AI — Environment Configuration

# App
PROJECT_NAME="SmartCampus AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with pgvector)
# For local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/smartcampus_db
# For zero-dependency dev fallback: sqlite+aiosqlite:///./smartcampus.db
DATABASE_URL="sqlite+aiosqlite:///./smartcampus.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/smartcampus_db"

# AI Provider Configuration
# Supported providers: "gemini", "openai", "mock"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"
EMBEDDING_MODEL="text-embedding-004"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend App Config
VITE_API_BASE_URL="http://localhost:8000/api/v1"
